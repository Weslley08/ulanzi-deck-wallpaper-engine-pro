{
  "name": "ulanzi-deck-wallpaper-engine-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Ulanzi D200 Wallpaper Engine PRO development and tests",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.12.2 <21"
  },
  "scripts": {
    "setup": "npm ci && npm ci --prefix com.ulanzi.wallpaperenginepro.ulanziPlugin",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "typecheck": "tsc --project tsconfig.json",
    "package": "node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:sdk": "node scripts/check-sdk.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check": "npm run check:structure && npm run check:sdk && npm run typecheck && npm test",
    "measure": "node scripts/measure.mjs",
    "bump": "node scripts/bump-version.mjs",
    "audit": "npm audit && npm audit --prefix com.ulanzi.wallpaperenginepro.ulanziPlugin"
  },
  "devDependencies": {
    "@types/node": "20.12.14",
    "typescript": "7.0.2",
    "ws": "8.22.1"
  }
}
